DLQ_AI_PROVIDER=

# defaults: anthropic=claude-sonnet-4-6, openai=gpt-4o, gemini=gemini-2.0-flash, ollama=llama3.2
DLQ_AI_MODEL=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

